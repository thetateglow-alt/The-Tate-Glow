# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAILJS CONFIGURATION (Client-side / GitHub Pages compatible)
# Create a free account at https://www.emailjs.com/
# 1. Add an Email Service (e.g. Gmail or Outlook) -> Service ID
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"

# 2. Create an Email Template -> Template ID
# Standard template variables sent: {{order_id}}, {{customer_name}}, {{customer_email}},
# {{customer_phone}}, {{delivery_address}}, {{city}}, {{payment_method}}, {{items_summary}},
# {{subtotal}}, {{discount}}, {{delivery_fee}}, {{total}}, {{glow_points_earned}}
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"

# 3. Account Settings -> Public Key
VITE_EMAILJS_PUBLIC_KEY="public_key_xxxxxxx"

# GMAIL_USER: Optional Gmail account reference (e.g. thetateglow@gmail.com)
GMAIL_USER="thetateglow@gmail.com"

# GMAIL_APP_PASSWORD: Optional 16-character Google App Password (if using custom server SMTP)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
