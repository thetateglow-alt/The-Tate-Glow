rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin verification: Any user listed in the admins collection (by UID or email), adminUsers collection, or the store owner email
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))) ||
        (request.auth.token.email != null && request.auth.token.email == 'thetateglow@gmail.com')
      );
    }

    // 1. Users collection: Users can read and write only their own document; admins can read all
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // 2. Products collection: Anyone can read the products catalog; users listed in admins can create, update and delete; checkout can decrement stock
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock
      );
    }

    // 3. Orders collection: Customers (including anonymous guests) can create and read/write their own orders; admins can manage all orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() || true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 4. User subcollection orders (backup path)
    match /users/{userId}/orders/{orderId} {
      allow create, read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // 5. Admins collection: Admins can read; NOBODY can write from the client
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 6. Inventory: Anyone can view stock; admins can manage; checkout can decrement stock
    match /inventory/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastRestockedAt', 'status']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0
      );
    }

    // 7. Inventory Audit Logs: Admin only
    match /inventoryLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. Discounts & Promos: Anyone can validate promo codes; only admins can write
    match /discounts/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Homepage CMS Content: Public read; admin write
    match /homepageContent/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Customers directory: Customer can create/read their own; admin can manage
    match /customers/{customerId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 11. General Audit Logs: Admin only
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 12. System status & seed flags: Public read, admin write
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Contact Inquiries: Anyone can submit a contact inquiry; admins can read, update, and delete
    match /contact_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
