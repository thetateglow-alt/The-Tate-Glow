rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Security Gate: Administrator MUST have a verified email address to prevent spoofing
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'thetateglow@gmail.com' ||
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
        );
    }

    // 1. Products: Public read ONLY when status is "published"; Admins can read and write everything
    match /products/{productId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // 2. Orders: Customers can create orders directly (GitHub Pages client-side mode).
    // Customers can read their own orders; Admins can read, update, and delete all orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email
      ));
      allow update, delete: if isAdmin();
    }

    // 3. User subcollection order history: customer can create and read their own orders; update/delete by admin
    match /users/{userId}/orders/{orderId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update, delete: if isAdmin();
    }

    // 4. Physical Inventory: Public read for stock availability; ONLY admins can write
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Inventory movement audit logs: ONLY admins can read and write
    match /inventoryLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 6. Customers: Customers can create their profile during checkout; read their own record; admin write
    match /customers/{customerId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
      allow update, delete: if isAdmin();
    }

    // 7. Discounts: Public read for promo validation; ONLY admins can write
    match /discounts/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Homepage CMS: Public read; ONLY admins can write
    match /homepageContent/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Admin users: ONLY verified admins can read and write
    match /adminUsers/{email} {
      allow read, write: if isAdmin();
    }

    // 10. Audit logs: ONLY admins can read and write
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
